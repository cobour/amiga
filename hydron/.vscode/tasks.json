{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Floppy Loader Debug",
			"type": "amigaassembly",
			"vasm": {
				"enabled": true,
				"command": "${config:amiga-assembly.binDir}/vasmm68k_mot",
				"args": [
					"-m68000",
					"-Fhunk",
					"-linedebug",
					"-DDEBUG",
					"-DSTANDARD_EXE",
					"-DUSE_TRACKDISK"
				]
			},
			"vlink": {
				"enabled": true,
				"command": "${config:amiga-assembly.binDir}/vlink",
				"includes": "src/system/debug_loader.asm",
				"excludes": "",
				"createStartupSequence": true,
				"createExeFileParentDir": true,
				"exefilename": "../uae/dh0/Hydron",
				"entrypoint": "src/system/debug_loader.asm",
				"args": [
					"-bamigahunk",
					"-Bstatic"
				]
			},
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"dependsOn": [
				"Run data-tool"
			]
		},
