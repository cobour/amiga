    "version": "0.2.0",
    "configurations": [
        {
            "type": "amiga-assembly",
            "request": "launch",
            "name": "Run WHDLoad Debug",
            "stopOnEntry": false,
            "trace": false,
            "program": "${workspaceFolder}/uae/dh0/Hydron",
            "remoteProgram": "SYS:Hydron",
            "emulatorType": "fs-uae",
            "emulatorArgs": [
                "--chip_memory=1024", // 1024 because AmigaDOS is in mem
                "--slow_memory=1024", // 1024 because AmigaDOS is in mem
                //"--slow_memory=0",
                "--fast_memory=0",
                //"--kickstart_file=/Users/frank/Development/projects/kickroms/kick13.rom",
                "--kickstart_file=/Users/frank/Development/projects/kickroms/kick31.rom",
                "--hard_drive_0=${workspaceFolder}/uae/dh0",
                "--automatic_input_grab=0",
                "--joystick_port_1=keyboard",
                "--amiga_model=A500",
                "--automatic_input_grab=0",
                "--video_sync=0",
                "--fullscreen=0"
            ],
            "preLaunchTask": "Build WHDLoad Debug"
        },
        {
            "type": "amiga-assembly",
            "request": "launch",
            "name": "Run WHDLoad Release",
